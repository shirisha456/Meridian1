DATABASE_URL=postgresql+asyncpg://meridian:meridian@localhost:5433/meridian
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Must be overridden to a long random value outside development —
# Settings.assert_safe_for_environment() refuses to boot in production
# with this placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

REDIS_URL=redis://localhost:6380/0
